{
  "rewrites": [
    { "source": "/api/chat", "destination": "/api/chat" },
    { "source": "/api/generate-tests", "destination": "/api/generate-tests" },
    { "source": "/api/hints", "destination": "/api/hints" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "env": {
    "GROQ_API_KEY": "@groq_api_key"
  }
}
