{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/chat", "destination": "/api/chat.js" },
    { "source": "/api/hints", "destination": "/api/hints.js" },
    { "source": "/api/generate-tests", "destination": "/api/generate-tests.js" },
    { "source": "/api/explain-question", "destination": "/api/explain-question.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
